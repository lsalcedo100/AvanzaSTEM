# Required for the newsletter email API provider.
RESEND_API_KEY=

# Optional sender identity for newsletter notifications.
# If omitted, the app uses: Avanza STEM <newsletter@avanzastem.org>
# This sender only works after you verify the Avanza STEM domain in Resend.
NEWSLETTER_FROM_EMAIL=

# Optional override for the destination inbox.
# If omitted, signups are sent to liam@avanzastem.org.
NEWSLETTER_RECIPIENT_EMAIL=

# Optional sender identity for contact form notifications.
# If omitted, the app uses: Avanza STEM <contact@avanzastem.org>
# This sender only works after you verify the Avanza STEM domain in Resend.
CONTACT_FROM_EMAIL=

# Optional override for the contact form destination inbox.
# If omitted, contact inquiries are sent to liam@avanzastem.org.
CONTACT_RECIPIENT_EMAIL=

# Optional: browser key for the Google Maps basemap on /find-a-workshop.
# Requires a billing-enabled Google Cloud project with the Maps JavaScript API
# enabled. Restrict the key to your domains. Without it (or if the key fails
# auth at runtime) the map falls back to Leaflet on OpenStreetMap tiles, which
# needs no key and renders the same pins.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Optional: a Map ID from the Google Cloud console, used to brand the basemap.
# Google requires a map ID for the HTML pins; the code falls back to the
# documented DEMO_MAP_ID (default styling) when this is unset.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
